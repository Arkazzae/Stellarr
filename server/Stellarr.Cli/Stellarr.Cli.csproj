<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellarr.Cli</RootNamespace>
    <AssemblyName>Stellarr.Cli</AssemblyName>
    <Version>2.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../Stellarr.Api/Stellarr.Api.csproj" />
    <InternalsVisibleTo Include="Stellarr.Api.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The CLI reads the same installation defaults as the API, from the same file. -->
    <Content Include="../Stellarr.Api/appsettings.json" Link="appsettings.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
