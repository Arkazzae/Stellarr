{
  "ConnectionStrings": {
    "Database": "Data Source=data/stellarr.db;Cache=Shared;Pooling=True"
  },
  "Storage": {
    "Endpoint": "http://127.0.0.1:9000",
    "AccessKey": "stellarr",
    "SecretKey": "stellarr-development-secret",
    "Bucket": "stellarr-images"
  },
  "Uploads": {
    "MaxImageBytes": 10485760,
    "MaxAudioBytes": 26214400,
    "MaxVideoBytes": 104857600,
    "MaxFileBytes": 26214400,
    "MaxStoredBytesPerUser": 2147483648,
    "MaxStoredBytes": 21474836480,
    "MinimumFreeDataRootBytes": 1073741824,
    "MaxConcurrentUploads": 4
  },
  "Mail": {
    "Enabled": false,
    "ResendApiKey": "",
    "FromAddress": "",
    "FromName": "Stellarr"
  },
  "Maintenance": {
    "Enabled": true,
    "InitialDelayMinutes": 5,
    "IntervalHours": 1,
    "BatchSize": 1000,
    "MessageChangeRetentionDays": 30
  },
  "AllowedHosts": "*",
  "Desktop": {
    "CanonicalOrigin": "",
    "MinimumVersion": "0.1.0",
    "RecommendedVersion": "0.1.0"
  },
  "Stellarr": {
    "InstanceName": "Stellarr",
    // Link previews. When a message contains a link, the server reads the page
    // once, in the background, and stores what it found — including a copy of
    // the preview image, so no reader's browser ever contacts the linked host.
    //
    // AllowPrivateNetworks is the one setting here with teeth. Off, the
    // unfurler can only reach public addresses; on, anybody who can post a
    // message can make this server open connections inside your network.
    // Turn it on only if you actually want previews of your own intranet.
    //
    // Enabled=false stops all outbound fetching. Links to YouTube and Vimeo
    // still get a player, because recognising those needs no request.
    "Embeds": {
      "Enabled": true,
      "MaxPerMessage": 2,
      "TimeoutSeconds": 6,
      "AllowPrivateNetworks": false
    }
  }
}
