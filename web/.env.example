# Public web-integration key for the GIF browser. GIPHY requires Search and
# Trending calls to originate in the browser, so this value is intentionally
# included in the client bundle.
NEXT_PUBLIC_GIPHY_API_KEY=

# Optional ICE servers for the WebRTC voice transport, as a JSON array.
# A LAN-only self-hosted instance normally needs none.
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.example.org:3478"}]

# Where `next dev` proxies /api, /assets and /hubs. Production uses Nginx and
# ignores this. Defaults to http://127.0.0.1:5000.
# STELLARR_API_ORIGIN=http://127.0.0.1:5000

# Extra hostnames allowed to load Next.js dev-only chunks. 127.0.0.1 is
# included automatically. Use a comma-separated list for an IDE/remote preview.
# STELLARR_ALLOWED_DEV_ORIGINS=preview.example.test,devbox.example.test
