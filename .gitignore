# ---------------------------------------------------------------------------
# Local configuration and secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
*.local

*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
secrets/
certs/

# Local Compose overrides may contain host paths, ports and credentials.
compose.override.yml
compose.override.yaml
docker-compose.override.yml
docker-compose.override.yaml

# ---------------------------------------------------------------------------
# Runtime data — the real deployment mounts this outside the repository
# ---------------------------------------------------------------------------
/data/
/uploads/
/storage/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.log
*.pid

# ---------------------------------------------------------------------------
# .NET
# ---------------------------------------------------------------------------
**/bin/
**/obj/
**/TestResults/
**/artifacts/
/.artifacts/
# The top-level artifacts/ is not .NET output but the browser's binaries, their
# manifest and the recipes that build some of them.
!/artifacts/
*.user
*.suo
*.userosscache
*.sln.docstates
coverage.cobertura.xml

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
**/__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Node / test runners
# ---------------------------------------------------------------------------
**/node_modules/
**/.turbo/
**/dist/
**/out/
**/coverage/
**/.nyc_output/
**/playwright-report/
**/test-results/
**/blob-report/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Documentation site (docs/): VitePress build output and cache.
/docs/.vitepress/dist/
/docs/.vitepress/cache/

# Copies that artifacts/assemble.mjs makes of artifacts/files/ and of the
# recipes' outputs at the paths artifacts/manifest.json serves them under. The
# model registry beside them stays tracked.
/web/public/audio/rnnoise.wasm
/web/public/audio/gtcrn.wasm
/web/public/audio/speex.wasm
/web/public/codecs/
/web/public/bergamot-models/*/

# A recipe builds its outputs here; artifacts/assemble.mjs reads them only when
# a manifest entry names a recipe. They are not committed.
/artifacts/recipes/*/out/

# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
/media/target/
# **/bin/ above is .NET build output, but src/bin holds extra binaries of a
# Rust crate.
!/media/src/bin/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
# scripts/seed-dev.py leaves bytecode behind when it runs.
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Editors, operating systems and temporary files
# ---------------------------------------------------------------------------
.vs/
.idea/
.vscode/
.fleet/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp
*.temp
.playwright-mcp/