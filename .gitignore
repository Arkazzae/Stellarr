# Documentation site (docs/): VitePress build output and cache.
/docs/.vitepress/dist/
/docs/.vitepress/cache/

# RNNoise is copied deterministically from the locked npm package by
# web/scripts/copy-audio-assets.mjs. Keep our own VAD worklet tracked.
/web/public/audio/rnnoise-worklet.js
/web/public/audio/rnnoise.wasm
/web/public/audio/rnnoise_simd.wasm
/web/public/audio/gtcrn-worklet.js
/web/public/audio/gtcrn.wasm
/web/public/audio/speex-worklet.js
/web/public/audio/speex.wasm

# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
/media/target/
# **/bin/ above is .NET build output, but src/bin holds extra binaries of a
# Rust crate.
!/media/src/bin/

