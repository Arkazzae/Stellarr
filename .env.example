
# Where `next dev` proxies /api, /assets and /hubs. Production uses Nginx and
# ignores this. Defaults to http://127.0.0.1:5000.
# STELLARR_API_ORIGIN=http://127.0.0.1:5000

# Extra hostnames allowed to load Next.js dev-only chunks. 127.0.0.1 is
# included automatically. Use a comma-separated list for an IDE/remote preview.
# STELLARR_ALLOWED_DEV_ORIGINS=preview.example.test,devbox.example.test

# The instance's address. STELLARR_DOMAIN is the name people reach it at: keep
# localhost for the local quick start, and set DNS and trusted TLS before making
# the instance public. STELLARR_PUBLIC_PORT is the HTTPS port browsers use, by
# default the published STELLARR_HTTPS_PORT and 443 behind a proxy. The public
# address in mail links and the desktop handshake is https://STELLARR_DOMAIN with
# that port, which STELLARR_PUBLIC_URL overrides. PUBLIC_HOST is the older name of
# STELLARR_DOMAIN. PUBLIC_IP=auto resolves the domain's A record.
# STELLARR_DOMAIN=chat.example.com
# STELLARR_PUBLIC_PORT=443
# STELLARR_PUBLIC_URL=https://chat.example.com
# PUBLIC_IP=auto
# STELLARR_HTTP_PORT=8888
# STELLARR_HTTPS_PORT=8443

# Voice: each browser sends its media once to Stellarr Media, the media server
# in the container, which forwards it to the rest of the call. A browser not on
# this host needs PUBLIC_IP set above and UDP STELLARR_MEDIA_PORT forwarded to
# the host on the same external port; without PUBLIC_IP it connects only
# through TURN. docs/stellarr-media.md lists what the media server does not do
# yet. The development stack publishes the media server on
# STELLARR_DEV_MEDIA_PORT instead.
# STELLARR_MEDIA_PORT=49000
# STELLARR_DEV_MEDIA_PORT=49100

# Release the production stack runs: ghcr.io/arkazzae/stellarr:${STELLARR_VERSION}.
# Pin a release tag for a real installation; "latest" follows new releases.
# STELLARR_VERSION=latest

# Language of the interface and of server messages: en or pl. An installation
# upgraded from a Polish-only build sets pl to keep its server messages in Polish.
# STELLARR_LANGUAGE=en

# Public web-integration key used by the client-side GIPHY search. GIPHY
# requires Search and Trending calls to originate in the browser. The key can
# also be set in Cockpit under Integrations, which wins over this one, and
# where GIFs can be turned off and the key checked against GIPHY.
GIPHY_API_KEY=

# Cockpit, the owner's operator panel. Development defaults to
# http://localhost:3001 and production serves it from /cockpit/ on the same
# origin as Stellarr.
# STELLARR_DEV_COCKPIT_PORT=3001
# STELLARR_TIME_ZONE=Europe/Warsaw
# Name and compatibility versions advertised by the desktop client handshake.
# STELLARR_INSTANCE_ID=11111111-2222-4333-8444-555555555555
# STELLARR_INSTANCE_NAME=Stellarr
# STELLARR_DESKTOP_MINIMUM_VERSION=0.1.0
# STELLARR_DESKTOP_RECOMMENDED_VERSION=0.1.3

# Mail. SMTP is the main transport: its server, port, security and login are set
# in Cockpit's settings. Resend replaces SMTP when it is turned on under
# Cockpit's Integrations. The SMTP password and the Resend key can be set here
# or in Cockpit, which stores them encrypted with the keys in the data volume;
# a value set in Cockpit wins over the one here. Cockpit never shows a secret
# again, only whether it is set and where from.
# onboarding@resend.dev works as the sender only through Resend.
STELLARR_SMTP_PASSWORD=
STELLARR_RESEND_API_KEY=
STELLARR_MAIL_FROM=

# Optional Pocket ID login. Local username/password login remains available.
# Pocket ID uses one issuer for all clients.
STELLARR_OIDC_ENABLED=false
STELLARR_OIDC_ISSUER=https://auth.example.com
STELLARR_OIDC_CLIENT_ID=
STELLARR_OIDC_CLIENT_SECRET=
STELLARR_OIDC_CLIENT_SECRET_FILE=
# The label of the sign-in button. Any text works, for example "Konto główne"
# on a Polish installation.
STELLARR_OIDC_DISPLAY_NAME=Main account
# Off by default: the instance asks for its own second step after the provider.
# On, a sign-in the provider confirmed with one of these amr values counts as it.
# STELLARR_OIDC_TRUST_PROVIDER_MFA=false
# STELLARR_OIDC_PROVIDER_MFA_AMR=mfa

# Upload admission protects the shared SQLite/RustFS volume. Values are bytes.
# STELLARR_UPLOAD_USER_BYTES=2147483648
# STELLARR_UPLOAD_TOTAL_BYTES=21474836480
# STELLARR_MIN_FREE_BYTES=1073741824
# STELLARR_MAX_CONCURRENT_UPLOADS=4
