
# Where `next dev` proxies /api, /assets and /hubs. Production uses Nginx and
# ignores this. Defaults to http://127.0.0.1:5000.
# STELLARR_API_ORIGIN=http://127.0.0.1:5000

# Extra hostnames allowed to load Next.js dev-only chunks. 127.0.0.1 is
# included automatically. Use a comma-separated list for an IDE/remote preview.
# STELLARR_ALLOWED_DEV_ORIGINS=preview.example.test,devbox.example.test

# Production host. Keep localhost for the local quick start; set DNS and trusted
# TLS before making the instance public. PUBLIC_IP=auto resolves PUBLIC_HOST's A record.
# PUBLIC_HOST=chat.example.com
# PUBLIC_IP=auto
# STELLARR_HTTP_PORT=8888
# STELLARR_HTTPS_PORT=8443

# Release the production stack runs: ghcr.io/arkazzae/stellarr:${STELLARR_VERSION}.
# Pin a release tag for a real installation; "latest" follows new releases.
# STELLARR_VERSION=latest

# Language of the interface and of server messages: en or pl. An installation
# upgraded from a Polish-only build sets pl to keep its server messages in Polish.
# STELLARR_LANGUAGE=en

# Public web-integration key used by the client-side GIPHY search. GIPHY
# requires Search and Trending calls to originate in the browser.
GIPHY_API_KEY=

# Owner operations panel. Development defaults to http://localhost:3001 and
# production serves it from /ops/ on the same origin as Stellarr.
# STELLARR_DEV_OPS_PORT=3001
# STELLARR_TIME_ZONE=Europe/Warsaw
# STELLARR_PUBLIC_URL=https://stellarr.example.net
# Name and compatibility versions advertised by the desktop client handshake.
# STELLARR_INSTANCE_ID=11111111-2222-4333-8444-555555555555
# STELLARR_INSTANCE_NAME=Stellarr
# STELLARR_DESKTOP_MINIMUM_VERSION=0.1.0
# STELLARR_DESKTOP_RECOMMENDED_VERSION=0.1.3

# Resend stays backend-only. The OPs API reports only whether the key is present
# and never stores or returns its value.
STELLARR_RESEND_API_KEY=
STELLARR_MAIL_FROM=onboarding@resend.dev

# Optional Pocket ID login. Local username/password login remains available.
# Pocket ID uses one issuer for all clients.
STELLARR_OIDC_ENABLED=false
STELLARR_OIDC_ISSUER=https://auth.example.com
STELLARR_OIDC_CLIENT_ID=
STELLARR_OIDC_CLIENT_SECRET=
STELLARR_OIDC_CLIENT_SECRET_FILE=
# The label of the sign-in button. Any text works, for example "Konto główne"
# on a Polish installation.
STELLARR_OIDC_DISPLAY_NAME=Main account

# Upload admission protects the shared SQLite/RustFS volume. Values are bytes.
# STELLARR_UPLOAD_USER_BYTES=2147483648
# STELLARR_UPLOAD_TOTAL_BYTES=21474836480
# STELLARR_MIN_FREE_BYTES=1073741824
# STELLARR_MAX_CONCURRENT_UPLOADS=4
